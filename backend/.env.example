# Copy this file to .env for local development. Never commit .env.
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://mentora:mentora_local_only@localhost:5432/mentora

# Required outside local development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# --- AI teacher ---
# Your Anthropic API key (console.anthropic.com). Never commit it.
# ANTHROPIC_API_KEY=
# Model and thinking effort. Cheaper alternatives: claude-sonnet-5-5, claude-haiku-5-5.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# AI_PROVIDER=none          # turn the teacher off entirely

# --- Free development option: Google Gemini (aistudio.google.com) ---
# Free tiers may use requests to train models: made-up test students only, never real ones.
# Set the key with:  powershell -ExecutionPolicy Bypass -File scripts\set_gemini_key.ps1
# AI_PROVIDER=openai_compatible
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Groq: https://api.groq.com/openai/v1/
# DAILY_MESSAGE_LIMIT=150
